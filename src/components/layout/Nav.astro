---
import { getSite } from '../../lib/site';
import { Icon } from 'astro-icon/components';

const site = await getSite();
const profile = site.profile;
const total = site.nav.length + 1; // 导航项 + 主题切换
---

<header id="site-nav" class="fixed z-20 select-none">
	<!-- 头像：组件中心，可按住拖拽 -->
	<div
		id="nav-toggle"
		class="relative w-12 h-12"
		title={site.title}
		aria-label="导航"
	>
		<img
			src={profile?.avatar}
			class="relative z-10 w-12 h-12 rounded-full object-cover block pointer-events-none select-none ring-2 ring-base-300 shadow-md"
			alt=""
			aria-hidden="true"
			loading="lazy"
			draggable="false"
		/>

		<!-- 圆形底：让图标在背景上清晰可见 -->
		<div class="nav-backdrop" aria-hidden="true"></div>

		<!-- 圆形排列：导航图标围绕头像等角度分布 -->
		{site.nav.map((item, i) => (
			<a
				class="nav-item btn btn-ghost btn-circle"
				href={item.href}
				title={item.label}
				aria-label={item.label}
				style={`--i: ${i}; --n: ${total}`}
			>
				{item.icon ? (
					<Icon name={item.icon} class="w-5 h-5" />
				) : (
					<span class="text-sm font-semibold">{item.label.slice(0, 1)}</span>
				)}
			</a>
		))}

		<!-- 主题切换：同样进入圆形排列 -->
		<button
			id="theme-toggle"
			class="nav-item theme-toggle btn btn-ghost btn-circle swap swap-rotate"
			title="切换深色 / 浅色"
			aria-label="切换深色 / 浅色"
			style={`--i: ${site.nav.length}; --n: ${total}`}
		>
			<span class="swap-off"><Icon name="lucide:moon" class="w-5 h-5" /></span>
			<span class="swap-on"><Icon name="lucide:sun" class="w-5 h-5" /></span>
		</button>
	</div>
</header>

{/* 竖屏底部导航条（长边非底边时显示，替代圆形菜单） */}
<nav id="mobile-bar" class="fixed inset-x-0 bottom-0 z-20" aria-label="底部导航">
	<div class="flex items-stretch glass-strong border-t border-base-300/60" style="padding-bottom: env(safe-area-inset-bottom)">
		{site.nav.map((item) => (
			<a class="flex-1 flex flex-col items-center justify-center py-2.5" href={item.href} title={item.label} aria-label={item.label}>
				{item.icon ? <Icon name={item.icon} class="w-5 h-5" /> : <span class="text-sm font-semibold">{item.label.slice(0, 1)}</span>}
			</a>
		))}
		<button
			class="theme-toggle flex-1 swap swap-rotate py-2.5"
			title="切换深色 / 浅色"
			aria-label="切换深色 / 浅色"
		>
			<span class="swap-off flex items-center justify-center">
				<Icon name="lucide:moon" class="w-5 h-5" />
			</span>
			<span class="swap-on flex items-center justify-center">
				<Icon name="lucide:sun" class="w-5 h-5" />
			</span>
		</button>
	</div>
</nav>

<!-- header 已解析：立即恢复折叠状态（此时为页面初始状态，无动画/无闪烁）；并禁用折叠动画直到初始化完成 -->
<script is:inline>
	try {
		if (localStorage.getItem('nav-collapsed') === '1') {
			document.getElementById('site-nav')?.classList.add('nav-collapsed');
		}
	} catch {
		/* 忽略 */
	}
	document.documentElement.classList.add('no-nav-anim');
</script>

<style>
	#site-nav {
		/* 锁定在右上区域（不贴边，留出展开空间：圆心距右/顶 ~120px > 环外缘 92px） */
		right: 96px;
		top: 96px;
		--r: 64px; /* 圆形排列半径 */
	}
	@media (max-width: 640px) {
		#site-nav {
			--r: 50px;
		}
	}
	/* 默认隐藏底部导航条 */
	#mobile-bar {
		display: none;
	}
	/* 手机（≤1024px，不允许横屏布局）或窄高视口：隐藏圆形菜单，显示底部导航条 */
	@media (max-width: 1024px), (max-aspect-ratio: 1 / 1) {
		#site-nav {
			display: none !important;
		}
		#mobile-bar {
			display: block;
		}
	}
		position: absolute;
		left: 50%;
		top: 50%;
		width: calc(2 * (var(--r) + 1.75rem));
		height: calc(2 * (var(--r) + 1.75rem));
		transform: translate(-50%, -50%);
		border-radius: 50%;
		background: var(--color-base-100) / 0.85;
		backdrop-filter: blur(6px);
		border: 1px solid var(--color-base-300);
		box-shadow: 0 6px 24px rgb(0 0 0 / 0.08);
		z-index: 0;
		transition:
			transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.3s ease;
	}
	#site-nav.nav-collapsed .nav-backdrop {
		transform: translate(-50%, -50%) scale(0.6);
		opacity: 0;
		/* 收起：先收按钮（stagger 45ms 逐项），再收外圈底 */
		transition-delay: 0.35s;
	}
	/* 图标按钮：围绕头像呈圆形等角分布 */
	#site-nav .nav-item {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 2.75rem;
		height: 2.75rem;
		z-index: 1;
		--angle: calc(var(--i) * (360deg / var(--n)));
		transform: translate(-50%, -50%)
			translate(calc(cos(var(--angle)) * var(--r)), calc(sin(var(--angle)) * var(--r)));
		opacity: 1;
		transition:
			transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.35s ease;
		transition-delay: calc(var(--i) * 45ms);
	}
	/* 点击收起：图标向中心收缩消失（再点从中心向外扩散展开） */
	#site-nav.nav-collapsed .nav-item {
		transform: translate(-50%, -50%) scale(0);
		opacity: 0;
		pointer-events: none;
		transition-delay: calc((var(--n) - var(--i)) * 45ms);
	}
	/* 页面加载/切换时禁用折叠动画（初始化完成后由脚本移除） */
	html.no-nav-anim #site-nav .nav-item,
	html.no-nav-anim #site-nav .nav-backdrop {
		transition: none !important;
	}
</style>
<script>
	// 主题：深色（business）/ 浅色（nord）切换
	const DARK_THEMES = ['dim', 'sunset', 'dracula', 'dark', 'synthwave', 'business', 'night', 'luxury'];
	const LIGHT_THEME = 'nord';
	const DARK_THEME = 'business';
	const isDark = (t: string) => DARK_THEMES.includes(t);
	const toggles = document.querySelectorAll<HTMLElement>('.theme-toggle');

	const applyTheme = (theme: string) => {
		document.documentElement.dataset.theme = theme;
		document.documentElement.dataset.themeMode = isDark(theme) ? 'dark' : 'light';
		try {
			localStorage.setItem('theme', theme);
		} catch {
			/* 忽略 */
		}
		toggles.forEach((t) => t.classList.toggle('swap-active', isDark(theme)));
	};
	applyTheme(document.documentElement.dataset.theme || LIGHT_THEME);

	toggles.forEach((t) => {
		t.addEventListener('click', () => {
			const current = document.documentElement.dataset.theme;
			applyTheme(isDark(current ?? LIGHT_THEME) ? LIGHT_THEME : DARK_THEME);
		});
	});

	const nav = document.getElementById('site-nav');
	if (nav) {
		// 点击切换折叠（固定居中，不支持拖拽）
		const setCollapsed = (collapsed: boolean) => {
			nav.classList.toggle('nav-collapsed', collapsed);
			try {
				localStorage.setItem('nav-collapsed', collapsed ? '1' : '0');
			} catch {
				/* 忽略 */
			}
		};
		try {
			if (localStorage.getItem('nav-collapsed') === '1') setCollapsed(true);
		} catch {
			/* 忽略 */
		}
		document.getElementById('nav-toggle')?.addEventListener('click', () => {
			setCollapsed(!nav.classList.contains('nav-collapsed'));
		});
	}

	// 初始化完成，恢复折叠/展开动画
	document.documentElement.classList.remove('no-nav-anim');
</script>
