---
import RadialLayout from '../../layouts/RadialLayout.astro';
import EncryptedPost from '../../components/post/EncryptedPost.astro';
import { Icon } from 'astro-icon/components';
import { getPosts } from '../../lib/posts';
import { formatDate } from '../../lib/utils';
import { render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

// 版权许可链接：CC 许可证 → creativecommons.org；其他 SPDX → spdx.org
const license = post.data.license;
const licenseUrl = license.startsWith('CC-')
	? `https://creativecommons.org/licenses/${license
			.toLowerCase()
			.replace('cc-', '')
			.split('-')
			.slice(0, -1)
			.join('-')}/4.0/`
	: `https://spdx.org/licenses/${license}.html`;
---

<RadialLayout
	title={post.data.title}
	description={post.data.description}
	rings={[]}
	core={{ title: '博客', subtitle: 'BLOG' }}
	progress
>
	<article class="glass rounded-box">
		<div class="card-body p-8">
			<header class="mb-6">
				<a class="link link-hover text-sm opacity-60" href="/blog/">← 返回博客列表</a>
				<h1 class="text-3xl font-bold mt-2">{post.data.title}</h1>
				<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-60 mt-2">
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
					{post.data.tags.map((tag) => (
						<a class="badge badge-soft badge-primary badge-sm no-underline" href={`/blog/tag/${tag}/`}>
							#{tag}
						</a>
					))}
				</div>
				{/* 辅助作者 / 无 AI 参与标记 */}
				{(post.data.assisted_by || post.data.no_ai) && (
					<div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2">
						{post.data.no_ai && (
							<span class="badge badge-success badge-soft badge-sm" title="本篇为纯人工创作">无 AI 参与</span>
						)}
						{post.data.assisted_by && <span class="text-sm opacity-70">辅助：{post.data.assisted_by}</span>}
					</div>
				)}
			</header>

			{post.data.password ? (
				<EncryptedPost md={post.body ?? ''} password={post.data.password} />
			) : (
				<div class="prose">
					<Content />
				</div>
			)}

			{/* 版权许可卡片：正文与上一篇/下一篇之间 */}
			<div class="glass rounded-box mt-8 p-4 flex items-center gap-3">
				<Icon name="lucide:scale" class="w-5 h-5 shrink-0 opacity-60" />
				<div class="flex-1 min-w-0">
					<p class="text-sm font-semibold">版权许可</p>
					<p class="text-xs opacity-60 mt-0.5 leading-relaxed">
						除特别注明外，本文采用
						<a class="link link-hover" href={licenseUrl} target="_blank" rel="noopener">
							{license}
						</a>
						许可协议进行许可。
					</p>
				</div>
			</div>

			{/* 上一篇 / 下一篇 */}
			<nav class="flex items-center justify-between gap-4 mt-10 pt-6 border-t border-base-300">
				{newer ? (
					<a class="btn btn-sm min-w-0" href={`/blog/${newer.id}/`}>
						<span class="text-base-content/50 shrink-0">←</span>
						<span class="truncate">{newer.data.title}</span>
					</a>
				) : (
					<span />
				)}
				{older ? (
					<a class="btn btn-sm min-w-0" href={`/blog/${older.id}/`}>
						<span class="truncate">{older.data.title}</span>
						<span class="text-base-content/50 shrink-0">→</span>
					</a>
				) : (
					<span />
				)}
			</nav>
		</div>
	</article>
</RadialLayout>
