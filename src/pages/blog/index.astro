---
import RadialLayout from '../../layouts/RadialLayout.astro';
import { buildRings } from '../../lib/circle';
import { getPosts } from '../../lib/posts';
import { formatDate } from '../../lib/utils';

const posts = await getPosts();
const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
const rings = buildRings({
	current: 'blog',
	core: { title: '博客', subtitle: 'BLOG' },
});
---

<RadialLayout title="博客" description="文章列表" rings={rings} core={{ title: '博客', subtitle: 'BLOG' }}>
	<header class="mb-6">
		<h1 class="text-3xl font-bold">博客</h1>
		<p class="opacity-60 mt-1">共 {posts.length} 篇文章</p>
	</header>

	<div class="space-y-4">
		{posts.map((post) => (
			<article class="glass rounded-box p-5">
				<div class="flex items-start gap-3">
					<h3 class="text-lg font-bold leading-snug flex-1 min-w-0">
						<a class="hover:text-primary transition-colors" href={`/blog/${post.id}/`}>
							{post.data.title}
						</a>
					</h3>
					<div class="flex items-center gap-1.5 shrink-0 ml-auto">
						{post.data.pinned && <span class="badge badge-primary badge-sm">置顶</span>}
						{post.data.password && <span class="badge badge-neutral badge-sm">🔒</span>}
						{post.data.no_ai && <span class="badge badge-success badge-soft badge-sm" title="无 AI 参与">无AI</span>}
					</div>
				</div>
				<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-60 mt-1">
					<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
					{post.data.tags.map((tag) => (
						<a class="badge badge-soft badge-primary badge-sm no-underline" href={`/blog/tag/${tag}/`}>
							#{tag}
						</a>
					))}
				</div>
				{post.data.description && <p class="opacity-70 text-sm mt-2">{post.data.description}</p>}
			</article>
		))}
	</div>
</RadialLayout>
