---
import RadialLayout from '../../../layouts/RadialLayout.astro';
import { spread } from '../../../lib/circle';
import type { Ring } from '../../../components/radial/RadialCircle.astro';
import { getPosts, getTags } from '../../../lib/posts';
import { formatDate } from '../../../lib/utils';

export async function getStaticPaths() {
	const tags = await getTags();
	return tags.map(([tag]) => ({ params: { tag } }));
}

// 路由参数通过 Astro.params 注入（getStaticPaths 的 props 字段才进 Astro.props）
const { tag } = Astro.params;
const posts = (await getPosts()).filter((p) => p.data.tags.includes(tag));

// 相关 tag：与当前 tag 共同出现的其他 tag，按共现次数取前 5
const withTag = posts;
const counts = new Map<string, number>();
for (const p of withTag) {
	for (const t of p.data.tags) {
		if (t !== tag) counts.set(t, (counts.get(t) ?? 0) + 1);
	}
}
const related = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5);

// 仅保留 tag 推荐环（隐藏板块切换环）
const outerNodes = related.map(([t], i) => ({
	text: `#${t}`,
	href: `/blog/tag/${t}/`,
	angle: spread(related.length, -70, 70)[i],
}));
const rings: Ring[] = [{ radius: 380, thickness: 18, nodes: outerNodes }];
---

<RadialLayout title={`标签：${tag}`} description={`标签 ${tag} 下的文章`} rings={rings} core={{ title: tag }}>
	<header class="mb-6">
		<h1 class="text-3xl font-bold">#{tag}</h1>
		<p class="opacity-60 mt-1">共 {posts.length} 篇文章{related.length > 0 ? ` · 相关标签 ${related.length} 个` : ''}</p>
		<a class="link link-hover text-sm opacity-60 mt-2 inline-block" href="/blog/">← 返回博客列表</a>
	</header>

	{posts.length > 0 ? (
		<div class="space-y-4">
			{posts.map((post) => (
				<article class="glass rounded-box p-5">
					<div class="flex items-start justify-between gap-3">
						<h3 class="text-lg font-bold leading-snug">
							<a class="hover:text-primary transition-colors" href={`/blog/${post.id}/`}>
								{post.data.title}
							</a>
						</h3>
						{post.data.pinned && <span class="badge badge-primary badge-sm shrink-0">置顶</span>}
						{post.data.password && <span class="badge badge-neutral badge-sm shrink-0">🔒</span>}
					</div>
					<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-60 mt-1">
						<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
						{post.data.tags.map((t) => (
							<a class="badge badge-soft badge-primary badge-sm no-underline" href={`/blog/tag/${t}/`}>
								#{t}
							</a>
						))}
					</div>
					{post.data.description && <p class="opacity-70 text-sm mt-2">{post.data.description}</p>}
				</article>
			))}
		</div>
	) : (
		<p class="opacity-60">该标签下暂无文章。</p>
	)}
</RadialLayout>
