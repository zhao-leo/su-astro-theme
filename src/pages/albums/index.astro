---
import RadialLayout from '../../layouts/RadialLayout.astro';
import { buildRings } from '../../lib/circle';
import { formatDate, sortByDateDesc } from '../../lib/utils';
import { getCollection } from 'astro:content';

const albums = sortByDateDesc(await getCollection('albums'));
const rings = buildRings({
	current: 'albums',
	core: { title: '相册', subtitle: 'ALBUMS' },
});
---

<RadialLayout title="相册" description="照片墙" rings={rings} core={{ title: '相册', subtitle: 'ALBUMS' }}>
	<header class="mb-6">
		<h1 class="text-3xl font-bold">相册</h1>
		<p class="opacity-60 mt-1">用照片记录生活</p>
	</header>

	{albums.length > 0 ? (
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-start">
			{albums.map((album) => {
				const photos = album.data.photos ?? [];
				const cover = album.data.cover ?? photos[0]?.src;
				const extra = photos.slice(1, 3);
				return (
					<a
						class="glass rounded-box overflow-hidden group block"
						href={`/albums/${album.id}/`}
					>
						<div class="flex items-stretch">
							{/* 封面：固定宽高（object-cover 裁剪），保证卡片等高 */}
							{cover && (
								<div class="relative shrink-0 w-44 sm:w-52 h-40 sm:h-44 overflow-hidden">
									<img
										class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
										src={cover}
										alt={album.data.title}
										loading="lazy"
									/>
								</div>
							)}

							{/* 信息区 */}
							<div class="p-4 flex-1 min-w-0">
								<h3 class="font-bold leading-snug group-hover:text-primary transition-colors">
									{album.data.title}
								</h3>
								<p class="text-sm opacity-60 mt-2 flex flex-wrap gap-x-2">
									<span>{photos.length} 张</span>
									{album.data.location && <span>· {album.data.location}</span>}
								</p>
								<p class="text-xs opacity-40 mt-1">{formatDate(album.data.date)}</p>
							</div>

							{/* 横向扩展区：hover 时展开显示相册内更多照片 */}
							{extra.length > 0 && (
								<div class="extend hidden sm:flex items-stretch w-0 group-hover:w-40 transition-all duration-300 overflow-hidden shrink-0">
									{extra.map((ph) => (
										<img
											class="w-20 h-full object-cover shrink-0"
											src={ph.src}
											alt=""
											loading="lazy"
										/>
									))}
								</div>
							)}
						</div>
					</a>
				);
			})}
		</div>
	) : (
		<p class="opacity-60">还没有相册。</p>
	)}
</RadialLayout>
