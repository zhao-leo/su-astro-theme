---
import RadialLayout from '../../../layouts/RadialLayout.astro';
import { spread } from '../../../lib/circle';
import type { Ring } from '../../../components/radial/RadialCircle.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';
import { sortById } from '../../../lib/utils';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	const tags = new Set<string>();
	for (const project of projects) {
		for (const t of project.data.tags) tags.add(t);
	}
	return [...tags].map((tag) => ({ params: { tag } }));
}

// 路由参数通过 Astro.params 注入
const { tag } = Astro.params;
const projects = sortById(await getCollection('projects'));
const filtered = projects.filter((p) => p.data.tags.includes(tag));

// 相关 tag：与当前 tag 共同出现的其他 tag，按共现次数取前 5
const counts = new Map<string, number>();
for (const p of filtered) {
	for (const t of p.data.tags) {
		if (t !== tag) counts.set(t, (counts.get(t) ?? 0) + 1);
	}
}
const related = [...counts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 5);

// 仅保留 tag 推荐环（隐藏板块切换环），核心显示当前 tag
const rings: Ring[] = [
	{
		radius: 380,
		thickness: 18,
		nodes: related.map(([t], i) => ({
			text: `#${t}`,
			href: `/projects/tag/${t}/`,
			angle: spread(related.length, -70, 70)[i],
		})),
	},
];
---

<RadialLayout
	title={`标签：${tag}`}
	description={`标签 ${tag} 下的项目`}
	rings={rings}
	core={{ title: tag }}
>
	<header class="mb-6">
		<a class="link link-hover text-sm opacity-60" href="/projects/">← 返回项目列表</a>
		<h1 class="text-3xl font-bold mt-2">#{tag}</h1>
		<p class="opacity-60 mt-1">
			共 {filtered.length} 个项目{related.length > 0 ? ` · 相关标签 ${related.length} 个` : ''}
		</p>
	</header>

	{filtered.length > 0 ? (
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
			{filtered.map((project) => (
				<article class="glass rounded-box p-5">
					<h3 class="text-lg font-bold flex items-center gap-2">
						{project.data.title}
						{project.data.featured && <span class="badge badge-warning badge-sm">精选</span>}
					</h3>
					{project.data.description && <p class="text-sm opacity-70 mt-2">{project.data.description}</p>}
					<div class="flex flex-wrap gap-1.5 mt-3">
						{project.data.tags.map((t) => (
							<a class="badge badge-soft badge-neutral badge-sm no-underline" href={`/projects/tag/${t}/`}>
								#{t}
							</a>
						))}
					</div>
					<div class="flex flex-wrap gap-2 mt-4">
						<a class="btn btn-sm" href={project.data.url} rel="noopener" target="_blank">
							<Icon name="lucide:globe" class="w-4 h-4" />
							项目主页
						</a>
						{project.data.repo && (
							<a class="btn btn-sm btn-ghost" href={project.data.repo} rel="noopener" target="_blank">
								<Icon name="lucide:github" class="w-4 h-4" />
								源码
							</a>
						)}
						{project.data.package && (
							<a class="btn btn-sm btn-ghost" href={project.data.package} rel="noopener" target="_blank">
								<Icon name="lucide:package" class="w-4 h-4" />
								包
							</a>
						)}
					</div>
				</article>
			))}
		</div>
	) : (
		<p class="opacity-60">该标签下暂无项目。</p>
	)}
</RadialLayout>
